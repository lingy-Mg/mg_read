{
  "name": "@mgread-plugin/66manhua-cc",
  "version": "1.0.4",
  "private": true,
  "description": "MgRead public HTML source for 66manhua.cc.",
  "type": "module",
  "main": "dist/index.mjs",
  "packageManager": "npm@11.13.0",
  "engines": { "node": ">=24 <25", "npm": "11.13.0" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/contract.test.mjs test/source.test.mjs",
    "test:live": "npm run build && node --use-env-proxy --test test/live-source.test.mjs",
    "pack:plugin": "npm run build && node tools/mgread.mjs pack",
    "verify": "npm run typecheck && npm test && npm run pack:plugin"
  },
  "dependencies": { "cheerio": "1.1.0" },
  "devDependencies": { "@mgread/source-api": "file:../../../packages/mg_read_source_api", "@types/node": "24.13.3", "esbuild": "0.28.2", "typescript": "5.9.3" },
  "mgread": {
    "schemaVersion": 1,
    "id": "org.mgread.66manhua-cc",
    "displayName": "66漫画",
    "description": "66漫画公开网页数据源，支持首页发现、分类、搜索、详情、章节与图片阅读。",
    "pluginApi": 1,
    "packageMode": "single-file",
    "icon": "assets/icon.png",
    "contentKinds": ["manga"]
  }
}
