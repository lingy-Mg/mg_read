{
  "name": "@mgread-plugin/haohao-audio",
  "version": "1.0.0",
  "private": true,
  "description": "昊昊享听提供有声专辑、评书及其他音频内容，支持热门榜、分类、搜索和按章节收听。",
  "type": "module",
  "main": "dist/index.mjs",
  "bin": {
    "mgread": "tools/mgread.mjs"
  },
  "packageManager": "npm@11.19.1",
  "engines": {
    "node": ">=24",
    "npm": "11.13.0 || 11.19.1"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit && node tools/mgread.mjs build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/contract.test.mjs test/source.test.mjs",
    "test:live": "npm run build && node --use-env-proxy --test test/live-source.test.mjs",
    "pack:plugin": "npm run build && node tools/mgread.mjs pack",
    "verify": "npm run typecheck && npm test && npm run pack:plugin"
  },
  "devDependencies": {
    "@mgread/source-api": "file:../../../packages/mg_read_source_api",
    "@types/node": "24.13.3",
    "esbuild": "0.28.2",
    "typescript": "5.9.3"
  },
  "mgread": {
    "schemaVersion": 1,
    "id": "org.mgread.haohao-audio",
    "displayName": "昊昊享听",
    "description": "昊昊享听提供有声专辑、评书及其他音频内容，支持热门榜、分类、搜索和按章节收听。",
    "sourceUrl": "https://api-preview.toulaopao.cc/",
    "pluginApi": 1,
    "packageMode": "single-file",
    "contentKinds": [
      "audio"
    ]
  }
}
