{
  "name": "@mgread-plugin/xchina-photo",
  "version": "1.0.5",
  "private": true,
  "description": "MgRead mixed xChina source for photo albums, fiction and videos.",
  "type": "module",
  "main": "dist/index.mjs",
  "bin": {
    "mgread": "tools/mgread.mjs"
  },
  "packageManager": "npm@11.19.1",
  "engines": {
    "node": ">=24",
    "npm": "11.13.0 || 11.19.1"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node tools/mgread.mjs build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/contract.test.mjs test/source.test.mjs",
    "test:live": "npm run build && node --use-env-proxy --test test/live-source.test.mjs",
    "pack:plugin": "npm run build && node tools/mgread.mjs pack",
    "verify": "npm run typecheck && npm test && npm run pack:plugin"
  },
  "dependencies": {
    "cheerio": "1.2.0"
  },
  "devDependencies": {
    "@mgread/source-api": "file:../../../packages/mg_read_source_api",
    "@types/node": "24.13.3",
    "esbuild": "0.28.2",
    "typescript": "5.9.3"
  },
  "mgread": {
    "sourceUrl": "https://xchina001.ink/",
    "schemaVersion": 1,
    "id": "org.mgread.xchina-photo",
    "displayName": "小黄书",
    "description": "小黄书混合内容来源，提供套图、小说和视频。短篇小说直接阅读全文，长篇小说按网站真实章节目录阅读。",
    "pluginApi": 1,
    "packageMode": "single-file",
    "icon": "assets/icon.png",
    "contentKinds": [
      "manga",
      "novel",
      "video"
    ],
    "r18": true
  }
}
