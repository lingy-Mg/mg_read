{
  "name": "@mgread-plugin/35ge-info",
  "version": "1.0.5",
  "private": true,
  "description": "MgRead conversion of the user-provided 35小说 source.",
  "type": "module",
  "main": "dist/index.mjs",
  "packageManager": "npm@11.19.1",
  "engines": { "node": ">=24", "npm": "11.13.0 || 11.19.1" },
  "scripts": {
    "build": "tsc -p tsconfig.json && node tools/mgread.mjs build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/contract.test.mjs test/source.test.mjs",
    "test:live": "npm run build && node --use-env-proxy --test test/live-source.test.mjs",
    "pack:plugin": "npm run build && node tools/mgread.mjs pack",
    "verify": "npm run typecheck && npm test && npm run pack:plugin"
  },
  "dependencies": { "cheerio": "1.1.0" },
  "devDependencies": {
    "@mgread/source-api": "file:../../../packages/mg_read_source_api",
    "@types/node": "24.13.3",
    "esbuild": "0.28.2",
    "typescript": "5.9.3"
  },
  "mgread": {
    "sourceUrl": "http://www.35ge.info/",
    "schemaVersion": 1,
    "id": "org.mgread.35ge-info",
    "displayName": "35小说",
    "description": "35小说是网络小说阅读网站，按分类整理小说作品。可以查看作品介绍、章节目录和正文，按书名或关键词查找想读的小说。",
    "pluginApi": 1,
    "packageMode": "single-file",
    "icon": "assets/icon.png",
    "contentKinds": ["novel"],
    "r18": true
  }
}
