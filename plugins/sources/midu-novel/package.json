{
  "name": "@mgread-plugin/midu-novel",
  "version": "1.0.4",
  "private": true,
  "description": "Native MgRead source for Midu novels.",
  "type": "module",
  "main": "dist/index.mjs",
  "packageManager": "npm@11.19.1",
  "engines": {
    "node": ">=24",
    "npm": "11.13.0 || 11.19.1"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node tools/mgread.mjs build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/contract.test.mjs test/source.test.mjs",
    "test:live": "npm run build && node --use-env-proxy --test test/live-source.test.mjs",
    "pack:plugin": "npm run build && node tools/mgread.mjs pack",
    "verify": "npm run typecheck && npm test && npm run pack:plugin"
  },
  "devDependencies": {
    "@mgread/source-api": "file:../../../packages/mg_read_source_api",
    "@types/node": "24.13.3",
    "esbuild": "0.28.2",
    "typescript": "5.9.3"
  },
  "mgread": {
    "sourceUrl": "https://m.midukanshu.com/",
    "schemaVersion": 1,
    "id": "org.mgread.midu-novel",
    "displayName": "米读小说",
    "description": "米读小说是网络小说阅读平台，提供小说发现与分类书目。可搜索作品、查看介绍和章节目录，并按章节阅读小说正文。",
    "pluginApi": 1,
    "packageMode": "single-file",
    "icon": "assets/icon.png",
    "contentKinds": [
      "novel"
    ],
    "r18": true
  }
}
