{
  "name": "@mgread-plugin/shukuge-365",
  "version": "1.0.7",
  "private": true,
  "description": "MgRead conversion of the user-provided 365小说网 source.",
  "type": "module",
  "main": "dist/index.mjs",
  "packageManager": "npm@11.19.1",
  "engines": {
    "node": ">=24",
    "npm": "11.13.0 || 11.19.1"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node tools/mgread.mjs build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/contract.test.mjs test/source.test.mjs",
    "test:live": "npm run build && node --use-env-proxy --test test/live-source.test.mjs",
    "pack:plugin": "npm run build && node tools/mgread.mjs pack",
    "verify": "npm run typecheck && npm test && npm run pack:plugin"
  },
  "dependencies": {
    "cheerio": "1.1.0"
  },
  "devDependencies": {
    "@mgread/source-api": "file:../../../packages/mg_read_source_api",
    "@types/node": "24.13.3",
    "esbuild": "0.28.2",
    "typescript": "5.9.3"
  },
  "mgread": {
    "sourceUrl": "http://www.shukuge.com/",
    "schemaVersion": 1,
    "id": "org.mgread.shukuge-365",
    "displayName": "365小说网",
    "description": "365小说网是网络小说阅读网站，按分类汇集小说作品。可查找书名、浏览作品介绍与章节目录，并阅读小说正文。",
    "pluginApi": 1,
    "packageMode": "single-file",
    "icon": "assets/icon.png",
    "contentKinds": [
      "novel"
    ],
    "r18": true
  }
}
