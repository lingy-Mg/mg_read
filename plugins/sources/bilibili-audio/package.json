{
  "name": "@mgread-plugin/bilibili-audio",
  "version": "1.0.2",
  "private": true,
  "description": "MgRead native search and playback source for Bilibili videos.",
  "type": "module",
  "main": "dist/index.mjs",
  "bin": { "mgread": "tools/mgread.mjs" },
  "packageManager": "npm@11.19.1",
  "engines": { "node": ">=24", "npm": "11.13.0 || 11.19.1" },
  "scripts": {
    "build": "tsc -p tsconfig.json && node tools/mgread.mjs build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/contract.test.mjs test/source.test.mjs",
    "test:live": "npm run build && node --use-env-proxy --test test/live-source.test.mjs",
    "pack:plugin": "npm run build && node tools/mgread.mjs pack",
    "verify": "npm run typecheck && npm test && npm run pack:plugin"
  },
  "devDependencies": {
    "@mgread/source-api": "file:../../../packages/mg_read_source_api",
    "@types/node": "24.13.3",
    "esbuild": "0.28.2",
    "typescript": "5.9.3"
  },
  "mgread": {
    "sourceUrl": "https://www.bilibili.com/",
    "schemaVersion": 1,
    "id": "org.mgread.bilibili-audio",
    "displayName": "哔哩哔哩",
    "description": "B站听书搜索、分P音频目录与发现页链接输入。",
    "pluginApi": 1,
    "packageMode": "single-file",
    "icon": "assets/icon.png",
    "contentKinds": ["audio"],
    "r18": false
  }
}
