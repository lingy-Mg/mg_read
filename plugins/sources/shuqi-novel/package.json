{
  "name": "@mgread-plugin/shuqi-novel",
  "version": "1.0.0",
  "private": true,
  "description": "书旗小说：官方网页分类推荐、搜索、目录与公开章节。",
  "type": "module",
  "main": "dist/index.mjs",
  "packageManager": "npm@11.19.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node tools/mgread.mjs build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/contract.test.mjs test/source.test.mjs",
    "test:live": "npm run build && node --use-env-proxy --test test/live-source.test.mjs",
    "pack:plugin": "npm run build && node tools/mgread.mjs pack",
    "verify": "npm run typecheck && npm test && npm run pack:plugin"
  },
  "devDependencies": {
    "@mgread/source-api": "file:../../../packages/mg_read_source_api",
    "@mgread/source-testkit": "file:../../../packages/mg_read_source_testkit",
    "@types/node": "24.13.3",
    "esbuild": "0.28.2",
    "typescript": "5.9.3"
  },
  "mgread": {
    "schemaVersion": 1,
    "id": "org.mgread.shuqi-novel",
    "displayName": "书旗小说",
    "description": "书旗小说提供网络小说推荐、作品搜索、详情与完整章节目录，可阅读站点公开章节；VIP章节明确标记为锁定。",
    "sourceUrl": "https://www.shuqi.com/",
    "pluginApi": 1,
    "packageMode": "single-file",
    "contentKinds": [
      "novel"
    ],
    "r18": false
  },
  "dependencies": {
    "cheerio": "1.1.0"
  }
}
