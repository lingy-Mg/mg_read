{
  "name": "@mgread-plugin/jmcomic",
  "version": "1.0.1",
  "private": true,
  "description": "MgRead source for JMComic mobile API and decoded manga pages.",
  "type": "module",
  "main": "dist/index.mjs",
  "bin": { "mgread": "tools/mgread.mjs" },
  "packageManager": "npm@11.19.1",
  "engines": { "node": ">=24", "npm": "11.13.0 || 11.19.1" },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit && node tools/mgread.mjs build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/contract.test.mjs test/source.test.mjs",
    "test:live": "npm run build && node --use-env-proxy --test test/live-source.test.mjs",
    "pack:plugin": "npm run build && node tools/mgread.mjs pack",
    "verify": "npm run typecheck && npm test && npm run pack:plugin"
  },
  "devDependencies": {
    "@jsquash/jpeg": "1.6.0",
    "@jsquash/png": "3.1.1",
    "@jsquash/webp": "1.5.0",
    "@mgread/source-api": "file:../../../packages/mg_read_source_api",
    "@types/node": "24.13.3",
    "esbuild": "0.28.2",
    "typescript": "5.9.3"
  },
  "mgread": {
    "schemaVersion": 1,
    "id": "org.mgread.jmcomic",
    "displayName": "禁漫天堂",
    "description": "JMComic 漫画数据源，支持搜索、分类、详情、目录和图片解码阅读。",
    "pluginApi": 1,
    "packageMode": "single-file",
    "contentKinds": ["manga"]
  }
}
