{
  "name": "@mgread-plugin/aisishuwu",
  "version": "0.1.0",
  "private": true,
  "description": "MgRead standard Node content-source plugin for the user-provided Alice Book House rules.",
  "type": "module",
  "main": "dist/index.mjs",
  "bin": {
    "mgread": "tools/mgread.mjs"
  },
  "packageManager": "npm@11.13.0",
  "engines": {
    "node": ">=24 <25",
    "npm": "11.13.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/contract.test.mjs",
    "test:live": "npm run build && node --use-env-proxy --test test/live-source.test.mjs",
    "pack:plugin": "npm run build && node tools/mgread.mjs pack",
    "verify": "npm run typecheck && npm test && npm run pack:plugin"
  },
  "dependencies": {
    "cheerio": "1.1.0"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "typescript": "5.9.3"
  },
  "mgread": {
    "schemaVersion": 1,
    "id": "org.mgread.aisishuwu",
    "displayName": "爱丽丝书屋",
    "pluginApi": 1,
    "contentKinds": [
      "novel"
    ]
  }
}
