{
  "name": "@mgread-plugin/wanou-wangpan",
  "version": "1.0.0",
  "private": true,
  "description": "MgRead source for Wogg multi-cloud video listings.",
  "type": "module",
  "main": "dist/index.mjs",
  "bin": { "mgread": "tools/mgread.mjs" },
  "packageManager": "npm@11.13.0",
  "engines": { "node": ">=24 <25", "npm": "11.13.0" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "test:live": "npm run build && node --use-env-proxy --test test/live-source.test.mjs",
    "pack:plugin": "npm run build && node tools/mgread.mjs pack",
    "verify": "npm run typecheck && npm test && npm run pack:plugin"
  },
  "devDependencies": {
    "@mgread/source-api": "file:../../../packages/mg_read_source_api",
    "@types/node": "24.13.3",
    "esbuild": "0.28.2",
    "typescript": "5.9.3"
  },
  "mgread": {
    "schemaVersion": 1,
    "id": "org.mgread.wanou-wangpan",
    "displayName": "玩偶网盘",
    "description": "玩偶影视网盘索引数据源，支持影视搜索、详情、分集与百度/夸克/优汐网盘链接解析。",
    "pluginApi": 1,
    "packageMode": "single-file","icon":"assets/icon.png",
    "contentKinds": ["video"]
  }
}
