{
  "name": "@mgread-plugin/wanou-wangpan",
  "version": "1.0.5",
  "private": true,
  "description": "MgRead source for Wogg multi-cloud video listings.",
  "type": "module",
  "main": "dist/index.mjs",
  "bin": {
    "mgread": "tools/mgread.mjs"
  },
  "packageManager": "npm@11.19.1",
  "engines": {
    "node": ">=24",
    "npm": "11.13.0 || 11.19.1"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node tools/mgread.mjs build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/contract.test.mjs test/source.test.mjs",
    "test:live": "npm run build && node --use-env-proxy --test test/live-source.test.mjs",
    "pack:plugin": "npm run build && node tools/mgread.mjs pack",
    "verify": "npm run typecheck && npm test && npm run pack:plugin"
  },
  "devDependencies": {
    "@mgread/source-api": "file:../../../packages/mg_read_source_api",
    "@types/node": "24.13.3",
    "esbuild": "0.28.2",
    "typescript": "5.9.3"
  },
  "mgread": {
    "sourceUrl": "https://www.wogg.net/",
    "schemaVersion": 1,
    "id": "org.mgread.wanou-wangpan",
    "displayName": "玩偶网盘",
    "description": "玩偶网盘是影视网盘资源索引网站，整理影视作品及其分集链接。可搜索片名、查看作品介绍，获取百度、夸克或优汐网盘中的相关资源。",
    "pluginApi": 1,
    "packageMode": "single-file",
    "icon": "assets/icon.png",
    "contentKinds": [
      "video"
    ],
    "r18": true
  }
}
