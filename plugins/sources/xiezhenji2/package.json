{
  "name": "@mgread-plugin/xiezhenji2",
  "version": "1.0.9",
  "private": true,
  "description": "MgRead conversion of the user-provided 写真集2 source.",
  "type": "module",
  "main": "dist/index.mjs",
  "packageManager": "npm@11.19.1",
  "engines": {
    "node": ">=24",
    "npm": "11.13.0 || 11.19.1"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node tools/mgread.mjs build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/contract.test.mjs test/source.test.mjs",
    "test:live": "npm run build && node --use-env-proxy --test test/live-source.test.mjs",
    "pack:plugin": "npm run build && node tools/mgread.mjs pack",
    "verify": "npm run typecheck && npm test && npm run pack:plugin"
  },
  "dependencies": {
    "@mgread/plugin-cache": "file:../../../packages/mg_read_plugin_cache",
    "cheerio": "1.1.0"
  },
  "devDependencies": {
    "@mgread/source-api": "file:../../../packages/mg_read_source_api",
    "@types/node": "24.13.3",
    "esbuild": "0.28.2",
    "typescript": "5.9.3"
  },
  "mgread": {
    "sourceUrl": "https://cosplaytele.com/",
    "schemaVersion": 1,
    "id": "org.mgread.xiezhenji2",
    "displayName": "写真集2",
    "description": "写真集2 是写真图集网站，通过不同主题分类整理相册。可搜索感兴趣的图集，查看相册介绍并浏览其中的图片。",
    "pluginApi": 1,
    "packageMode": "single-file",
    "icon": "assets/icon.png",
    "contentKinds": [
      "manga"
    ],
    "r18": true
  }
}
