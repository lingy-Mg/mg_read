{
  "name": "@mgread-plugin/xiaowei-duanju",
  "version": "1.0.4",
  "private": true,
  "description": "MgRead native source for the Xiaowei short-drama API.",
  "type": "module",
  "main": "dist/index.mjs",
  "bin": {
    "mgread": "tools/mgread.mjs"
  },
  "packageManager": "npm@11.19.1",
  "engines": {
    "node": ">=24",
    "npm": "11.13.0 || 11.19.1"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node tools/mgread.mjs build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/contract.test.mjs test/source.test.mjs",
    "test:live": "npm run build && node --use-env-proxy --test test/live-source.test.mjs",
    "pack:plugin": "npm run build && node tools/mgread.mjs pack",
    "verify": "npm run typecheck && npm test && npm run pack:plugin"
  },
  "devDependencies": {
    "@mgread/source-api": "file:../../../packages/mg_read_source_api",
    "@types/node": "24.13.3",
    "esbuild": "0.28.2",
    "typescript": "5.9.3"
  },
  "mgread": {
    "sourceUrl": "https://api.drama.9ddm.com/",
    "schemaVersion": 1,
    "id": "org.mgread.xiaowei-duanju",
    "displayName": "小微短剧",
    "description": "小微短剧是短剧观看网站，首页和分类页汇集短剧作品。可搜索剧名、查看剧情介绍和分集目录，按集观看短剧。",
    "pluginApi": 1,
    "packageMode": "single-file",
    "icon": "assets/icon.png",
    "contentKinds": [
      "video"
    ],
    "r18": true
  }
}
