{
  "name": "@mgread-plugin/discovery-demo",
  "version": "0.1.0",
  "private": true,
  "description": "Offline recursive discovery component demonstration source for MgRead.",
  "type": "module",
  "main": "dist/index.mjs",
  "bin": { "mgread": "tools/pack.mjs" },
  "packageManager": "npm@11.13.0",
  "engines": { "node": ">=24 <25", "npm": "11.13.0" },
  "scripts": {
    "build": "node --check dist/index.mjs",
    "typecheck": "node --check dist/index.mjs",
    "test": "node --test test/demo.test.mjs",
    "pack:plugin": "node tools/pack.mjs pack",
    "verify": "npm run build && npm test && npm run pack:plugin"
  },
  "mgread": {
    "schemaVersion": 1,
    "id": "org.mgread.discovery-demo",
    "displayName": "发现组件演示",
    "pluginApi": 1,
    "contentKinds": ["novel"]
  }
}
