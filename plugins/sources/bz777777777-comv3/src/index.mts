import{categories,type Context,BzSource}from'./source.js';interface Active extends Context{readonly dataDir:string;readonly app:object;readonly plugin:object;}interface Page{readonly cursor:string|null;readonly pageSize:number;}let context:Active|undefined,source:BzSource|undefined;export async function activate(next:Active){context=next;next.log.info('source_activated');}export async function search(request:Page&{readonly query:string}){if(request.cursor!==null)throw new Error('Search cursor unsupported.');const items=(await req().search(request.query)).slice(0,request.pageSize);return Object.freeze({items,nextCursor:null,totalCount:null});}export async function discover(request:Page&{readonly target:string|null;readonly collectionId:string|null}){if(request.target===null)return Object.freeze({kind:'document',document:{components:Object.freeze([{type:'section',id:'categories-section',title:'分类',subtitle:null,children:Object.freeze([{type:'categoryCollection',id:'categories',layout:'grid',categories:Object.freeze(categories.map(([id,title])=>Object.freeze({id,title,target:`category:${id}`,count:null,url:null})))}])}])}});const match=/^category:([a-z-]+)$/u.exec(request.target);if(match?.[1]===undefined)throw new Error('Target invalid.');const page=cursor(request.cursor,`category:${match[1]}`);const items=(await req().discover(match[1],page)).slice(0,request.pageSize).map(content=>Object.freeze({content,rank:null,metric:null,recommendation:null}));const collectionId=`category-books:${match[1]}`,continuation=items.length===request.pageSize?Object.freeze({target:request.target,cursor:`category:${match[1]}:${page+1}`}):null;if(request.collectionId!==null)return Object.freeze({kind:'append',collectionId,items:Object.freeze(items),continuation});return Object.freeze({kind:'document',document:{components:Object.freeze([{type:'section',id:`${collectionId}-section`,title:categories.find(([id])=>id===match[1])?.[1]??'分类',subtitle:null,children:Object.freeze([{type:'contentCollection',id:collectionId,layout:'list',items:Object.freeze(items),continuation}])}])}});}export async function searchSuggestions(){return Object.freeze({items:Object.freeze([]),nextCursor:null});}export async function getDetail(r:{readonly id:string}){return req().getDetail(r.id);}export async function getChapters(r:{readonly id:string}){return req().chapters(r.id);}export async function getContent(r:{readonly id:string;readonly chapterId:string}){return req().content(r.id,r.chapterId);}export async function resource(r:Record<string,unknown>){return req().resource(r);}function req(){if(context===undefined)throw new Error('Source not activated.');return source??=new BzSource(context);}function cursor(value:string|null,scope:string){if(value===null)return 1;const page=Number(new RegExp(`^${scope}:(\\d+)$`,'u').exec(value)?.[1]);if(!Number.isSafeInteger(page)||page<2)throw new Error('Cursor invalid.');return page;}
