{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "开发：启动 MgRead（自动选择设备）",
      "type": "process",
      "command": "flutter",
      "args": [
        "run"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "showReuseMessage": false,
        "clear": false
      },
      "problemMatcher": []
    },
    {
      "label": "检查：Dart 格式",
      "type": "process",
      "command": "dart",
      "args": [
        "format",
        "--output=none",
        "--set-exit-if-changed",
        "."
      ],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "showReuseMessage": false,
        "clear": false
      },
      "problemMatcher": []
    },
    {
      "label": "检查：Flutter 静态分析",
      "type": "process",
      "command": "flutter",
      "args": [
        "analyze"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "showReuseMessage": false,
        "clear": false
      },
      "problemMatcher": []
    },
    {
      "label": "检查：静态检查",
      "dependsOn": [
        "检查：Dart 格式",
        "检查：Flutter 静态分析"
      ],
      "dependsOrder": "sequence",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "showReuseMessage": false,
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "发布：打包 APK（Release）",
      "dependsOn": [
        "构建：APK（Release）",
        "整理：APK 到根目录 build"
      ],
      "dependsOrder": "sequence",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "showReuseMessage": false,
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "构建：APK（Release）",
      "dependsOn": [
        "准备：Android Runtime 资源"
      ],
      "dependsOrder": "sequence",
      "type": "process",
      "command": "flutter",
      "args": [
        "build",
        "apk",
        "--release",
        "--target-platform",
        "android-arm64"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "showReuseMessage": false,
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "准备：Android Runtime 资源",
      "type": "process",
      "command": "zsh",
      "args": [
        "${workspaceFolder}/tools/run_macos_apk_task.zsh",
        "prepare-runtime"
      ],
      "windows": {
        "command": "${workspaceFolder}/packages/mg_read_node_runtime/tools/node-v26.10.0-win-x64/node.exe",
        "args": [
          "${workspaceFolder}/packages/mg_read_node_runtime/tools/node-v26.10.0-win-x64/node_modules/npm/bin/npm-cli.js",
          "run",
          "build"
        ],
        "options": {
          "cwd": "${workspaceFolder}/packages/mg_read_node_runtime",
          "env": {
            "PATH": "${workspaceFolder}/packages/mg_read_node_runtime/tools/node-v26.10.0-win-x64;${env:PATH}"
          }
        }
      },
      "linux": {
        "command": "sh",
        "args": [
          "-c",
          "printf '%s\\n' '当前仓库未提供 Linux 的固定 Node Runtime 工具链，无法打包 APK。' >&2; exit 1"
        ]
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "showReuseMessage": false,
        "clear": false
      },
      "problemMatcher": []
    },
    {
      "label": "整理：APK 到根目录 build",
      "type": "process",
      "command": "zsh",
      "args": [
        "${workspaceFolder}/tools/run_macos_apk_task.zsh",
        "collect-apk"
      ],
      "windows": {
        "command": "${workspaceFolder}/packages/mg_read_node_runtime/tools/node-v26.10.0-win-x64/node.exe",
        "args": [
          "${workspaceFolder}/tools/collect_release_apk.mjs"
        ]
      },
      "linux": {
        "command": "sh",
        "args": [
          "-c",
          "printf '%s\\n' '当前仓库未提供 Linux 的固定 Node Runtime 工具链，无法整理 APK。' >&2; exit 1"
        ]
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "showReuseMessage": false,
        "clear": false
      },
      "problemMatcher": []
    },
    {
      "label": "发布：打包 Windows EXE（Release）",
      "dependsOn": [
        "构建：Windows（Release）",
        "校验：Windows 最终运行时",
        "打包：Windows ZIP 和 7z"
      ],
      "dependsOrder": "sequence",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "showReuseMessage": false,
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "发布：打包 APK 和 Windows EXE（Release）",
      "dependsOn": [
        "发布：打包 APK（Release）",
        "发布：打包 Windows EXE（Release）"
      ],
      "dependsOrder": "sequence",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "showReuseMessage": false,
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "构建：Windows（Release）",
      "dependsOn": [
        "准备：Windows Runtime 资源"
      ],
      "dependsOrder": "sequence",
      "type": "process",
      "command": "flutter",
      "args": [
        "build",
        "windows",
        "--release"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "showReuseMessage": false,
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "准备：Windows Runtime 资源",
      "type": "process",
      "command": "${workspaceFolder}/packages/mg_read_node_runtime/tools/node-v26.10.0-win-x64/node.exe",
      "args": [
        "${workspaceFolder}/packages/mg_read_node_runtime/tools/node-v26.10.0-win-x64/node_modules/npm/bin/npm-cli.js",
        "run",
        "stage:flutter-windows"
      ],
      "options": {
        "cwd": "${workspaceFolder}/packages/mg_read_node_runtime",
        "env": {
          "PATH": "${workspaceFolder}/packages/mg_read_node_runtime/tools/node-v26.10.0-win-x64;${env:PATH}"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "showReuseMessage": false,
        "clear": false
      },
      "problemMatcher": []
    },
    {
      "label": "校验：Windows 最终运行时",
      "type": "process",
      "command": "pwsh",
      "args": [
        "-NoProfile",
        "-File",
        "${workspaceFolder}/tools/verify_windows_release.ps1"
      ],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "打包：Windows ZIP 和 7z",
      "type": "process",
      "command": "pwsh",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/tools/package_windows_release.ps1"
      ],
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "showReuseMessage": false,
        "clear": false
      },
      "problemMatcher": []
    }
  ]
}
