{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "开发：启动 MgRead（自动选择设备）",
      "type": "process",
      "command": "flutter",
      "args": [
        "run"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "showReuseMessage": false,
        "clear": false
      },
      "problemMatcher": []
    },
    {
      "label": "检查：Dart 格式",
      "type": "process",
      "command": "dart",
      "args": [
        "format",
        "--output=none",
        "--set-exit-if-changed",
        "."
      ],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "showReuseMessage": false,
        "clear": false
      },
      "problemMatcher": []
    },
    {
      "label": "检查：Flutter 静态分析",
      "type": "process",
      "command": "flutter",
      "args": [
        "analyze"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "showReuseMessage": false,
        "clear": false
      },
      "problemMatcher": []
    },
    {
      "label": "检查：静态检查",
      "dependsOn": [
        "检查：Dart 格式",
        "检查：Flutter 静态分析"
      ],
      "dependsOrder": "sequence",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "showReuseMessage": false,
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "发布：打包 APK（Release）",
      "dependsOn": [
        "构建：APK（Release）",
        "整理：APK 到根目录 build"
      ],
      "dependsOrder": "sequence",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "showReuseMessage": false,
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "构建：APK（Release）",
      "dependsOn": [
        "准备：Android Runtime 资源"
      ],
      "dependsOrder": "sequence",
      "type": "process",
      "command": "flutter",
      "args": [
        "build",
        "apk",
        "--release",
        "--target-platform",
        "android-arm64"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "showReuseMessage": false,
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "准备：Android Runtime 资源",
      "type": "process",
      "command": "zsh",
      "args": [
        "${workspaceFolder}/tools/run_macos_apk_task.zsh",
        "prepare-runtime"
      ],
      "windows": {
        "command": "${workspaceFolder}/packages/mg_read_node_runtime/tools/node-v24.16.0-win-x64/node.exe",
        "args": [
          "${workspaceFolder}/packages/mg_read_node_runtime/tools/node-v24.16.0-win-x64/node_modules/npm/bin/npm-cli.js",
          "run",
          "build"
        ],
        "options": {
          "cwd": "${workspaceFolder}/packages/mg_read_node_runtime",
          "env": {
            "PATH": "${workspaceFolder}/packages/mg_read_node_runtime/tools/node-v24.16.0-win-x64;${env:PATH}"
          }
        }
      },
      "linux": {
        "command": "sh",
        "args": [
          "-c",
          "printf '%s\\n' '当前仓库未提供 Linux 的固定 Node Runtime 工具链，无法打包 APK。' >&2; exit 1"
        ]
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "showReuseMessage": false,
        "clear": false
      },
      "problemMatcher": []
    },
    {
      "label": "整理：APK 到根目录 build",
      "type": "process",
      "command": "zsh",
      "args": [
        "${workspaceFolder}/tools/run_macos_apk_task.zsh",
        "collect-apk"
      ],
      "windows": {
        "command": "${workspaceFolder}/packages/mg_read_node_runtime/tools/node-v24.16.0-win-x64/node.exe",
        "args": [
          "${workspaceFolder}/tools/collect_release_apk.mjs"
        ]
      },
      "linux": {
        "command": "sh",
        "args": [
          "-c",
          "printf '%s\\n' '当前仓库未提供 Linux 的固定 Node Runtime 工具链，无法整理 APK。' >&2; exit 1"
        ]
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "showReuseMessage": false,
        "clear": false
      },
      "problemMatcher": []
    },
    {
      "label": "发布：打包 Windows EXE（Release）",
      "dependsOn": [
        "构建：Windows（Release）",
        "整理：Windows 到根目录 build"
      ],
      "dependsOrder": "sequence",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "showReuseMessage": false,
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "发布：打包 APK 和 Windows EXE（Release）",
      "dependsOn": [
        "发布：打包 APK（Release）",
        "发布：打包 Windows EXE（Release）"
      ],
      "dependsOrder": "sequence",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "showReuseMessage": false,
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "构建：Windows（Release）",
      "dependsOn": [
        "准备：Windows Runtime 资源"
      ],
      "dependsOrder": "sequence",
      "type": "process",
      "command": "flutter",
      "args": [
        "build",
        "windows",
        "--release"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "showReuseMessage": false,
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "准备：Windows Runtime 资源",
      "type": "process",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-Command",
        "$ErrorActionPreference = 'Stop'; $runtimeRoot = Join-Path '${workspaceFolder}' 'packages/mg_read_node_runtime'; $nodeBin = Join-Path $runtimeRoot 'tools/node-v24.16.0-win-x64'; $env:PATH = $nodeBin + ';' + $env:PATH; Push-Location $runtimeRoot; try { & (Join-Path $nodeBin 'npm.cmd') run stage:flutter-windows; if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE } } finally { Pop-Location }"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "showReuseMessage": false,
        "clear": false
      },
      "problemMatcher": []
    },
    {
      "label": "整理：Windows 到根目录 build",
      "type": "process",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-Command",
        "$ErrorActionPreference = 'Stop'; $source = Join-Path '${workspaceFolder}' 'build/windows/x64/runner/Release'; $destination = Join-Path '${workspaceFolder}' 'build/mg_read-windows-release'; if (-not (Test-Path -LiteralPath $source)) { throw \"找不到 Windows Release 目录：$source\" }; New-Item -ItemType Directory -Force -Path $destination | Out-Null; Copy-Item -Path (Join-Path $source '*') -Destination $destination -Recurse -Force; $executable = Join-Path $destination 'mg_read.exe'; if (-not (Test-Path -LiteralPath $executable)) { throw \"找不到 Windows 可执行文件：$executable\" }; Write-Host \"Windows Release 已复制到：$destination\"; Start-Process -FilePath 'explorer.exe' -ArgumentList ('/select,\"' + $executable + '\"')"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "showReuseMessage": false,
        "clear": false
      },
      "problemMatcher": []
    }
  ]
}
