{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "开发：启动示例（自动选择设备）",
            "type": "process",
            "command": "flutter",
            "args": [
                "run"
            ],
            "options": {
                "cwd": "${workspaceFolder}/example"
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "showReuseMessage": false,
                "clear": false
            },
            "problemMatcher": []
        },
        {
            "label": "发布：打包 APK（Release）",
            "dependsOn": [
                "构建：APK（Release）",
                "整理：APK 到根目录 build"
            ],
            "dependsOrder": "sequence",
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "showReuseMessage": false,
                "clear": true
            },
            "problemMatcher": []
        },
        {
            "label": "发布：打包 Windows EXE（Release）",
            "dependsOn": [
                "构建：Windows（Release）",
                "整理：Windows 到根目录 build"
            ],
            "dependsOrder": "sequence",
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "showReuseMessage": false,
                "clear": true
            },
            "problemMatcher": []
        },
        {
            "label": "构建：APK（Release）",
            "type": "process",
            "command": "flutter",
            "args": [
                "build",
                "apk",
                "--release",
                "--target-platform",
                "android-arm64"
            ],
            "options": {
                "cwd": "${workspaceFolder}/example"
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "showReuseMessage": false,
                "clear": true
            },
            "problemMatcher": []
        },
        {
            "label": "整理：APK 到根目录 build",
            "type": "process",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-Command",
                "$ErrorActionPreference = 'Stop'; $source = Join-Path '${workspaceFolder}/example' 'build/app/outputs/flutter-apk/app-release.apk'; $destination = Join-Path '${workspaceFolder}' 'build/novel_reader_ui_example-release.apk'; if (-not (Test-Path -LiteralPath $source)) { throw \"找不到 APK：$source\" }; New-Item -ItemType Directory -Force -Path (Split-Path -Parent $destination) | Out-Null; Copy-Item -LiteralPath $source -Destination $destination -Force; Write-Host \"APK 已复制到：$destination\""
            ],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "showReuseMessage": false,
                "clear": false
            },
            "problemMatcher": []
        },
        {
            "label": "构建：Windows（Release）",
            "type": "process",
            "command": "flutter",
            "args": [
                "build",
                "windows",
                "--release"
            ],
            "options": {
                "cwd": "${workspaceFolder}/example"
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "showReuseMessage": false,
                "clear": true
            },
            "problemMatcher": []
        },
        {
            "label": "整理：Windows 到根目录 build",
            "type": "process",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-Command",
                "$ErrorActionPreference = 'Stop'; $source = Join-Path '${workspaceFolder}/example' 'build/windows/x64/runner/Release'; $destination = Join-Path '${workspaceFolder}' 'build/novel_reader_ui_example-windows-release'; if (-not (Test-Path -LiteralPath $source)) { throw \"找不到 Windows Release 目录：$source\" }; New-Item -ItemType Directory -Force -Path $destination | Out-Null; Copy-Item -Path (Join-Path $source '*') -Destination $destination -Recurse -Force; Write-Host \"Windows Release 已复制到：$destination\""
            ],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "showReuseMessage": false,
                "clear": false
            },
            "problemMatcher": []
        }
    ]
}
